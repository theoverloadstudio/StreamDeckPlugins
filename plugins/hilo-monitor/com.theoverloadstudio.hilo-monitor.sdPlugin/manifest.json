{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.theoverloadstudio.hilo-monitor",
  "Name": "Hilo Monitor",
  "Author": "The Overload Studio",
  "Description": "Adjust the Lynx Hilo USB analog Monitor Out level.",
  "Category": "Hilo Monitor",
  "CategoryIcon": "images/category",
  "Icon": "images/plugin",
  "CodePath": "plugin.mjs",
  "Version": "1.7.0.0",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "7.1" },
  "Nodejs": { "Version": "24" },
  "OS": [{ "Platform": "mac", "MinimumVersion": "13" }],
  "Actions": [
    {
      "UUID": "com.theoverloadstudio.hilo-monitor.up",
      "Name": "Monitor Up",
      "Tooltip": "Raise and unmute Monitor Out. Hold to ramp up to 0 dB.",
      "Controllers": ["Keypad"],
      "Icon": "images/action",
      "States": [{ "Image": "images/up", "ShowTitle": false }]
    },
    {
      "UUID": "com.theoverloadstudio.hilo-monitor.down",
      "Name": "Monitor Down",
      "Tooltip": "Lower Monitor Out. Hold to decrease gradually.",
      "Controllers": ["Keypad"],
      "Icon": "images/action",
      "States": [{ "Image": "images/down", "ShowTitle": false }]
    },
    {
      "UUID": "com.theoverloadstudio.hilo-monitor.mute",
      "Name": "Mute Monitor",
      "Tooltip": "Toggle the hardware mute for the left and right Monitor Out channels.",
      "Controllers": ["Keypad"],
      "Icon": "images/action",
      "States": [{ "Image": "images/mute", "ShowTitle": false }]
    },
    {
      "UUID": "com.theoverloadstudio.hilo-monitor.dim",
      "Name": "Dim Monitor",
      "Tooltip": "Toggle a 15 dB reduction relative to your current Monitor Out level.",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "Icon": "images/action",
      "States": [
        { "Image": "images/dim", "ShowTitle": false },
        { "Image": "images/dim-on", "ShowTitle": false }
      ]
    },
    {
      "UUID": "com.theoverloadstudio.hilo-monitor.mono",
      "Name": "Mono Monitor",
      "Tooltip": "Sum the Monitor Out mix into the left speaker. Press again to restore stereo.",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "PropertyInspectorPath": "mono-settings.html",
      "Icon": "images/action",
      "States": [
        { "Image": "images/mono", "ShowTitle": false },
        { "Image": "images/mono-on", "ShowTitle": false }
      ]
    },
    {
      "UUID": "com.theoverloadstudio.hilo-monitor.dial",
      "Name": "Monitor Volume Dial",
      "Tooltip": "Turn to adjust Analog Monitor Out in 0.5 dB steps.",
      "Controllers": ["Encoder"],
      "Encoder": {
        "Icon": "images/dial",
        "layout": "$B1",
        "TriggerDescription": { "Rotate": "Adjust Monitor Out" }
      },
      "Icon": "images/action",
      "States": [{ "Image": "images/dial", "Title": "Monitor Out" }]
    }
  ]
}
