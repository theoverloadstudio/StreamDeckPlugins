{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.theoverloadstudio.iseeyou-finder",
  "Name": "ISeeYou",
  "Author": "The Overload Studio",
  "Description": "Toggle or temporarily show the ISeeYou inspector from Stream Deck.",
  "Category": "ISeeYou",
  "CategoryIcon": "images/category",
  "Icon": "images/plugin",
  "CodePath": "plugin.mjs",
  "Version": "1.3.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    }
  ],
  "Actions": [
    {
      "UUID": "com.theoverloadstudio.iseeyou-finder.inspect",
      "Name": "Toggle ISeeYou",
      "Tooltip": "Press to open or close the ISeeYou window.",
      "Controllers": [
        "Keypad"
      ],
      "Icon": "images/action",
      "States": [
        {
          "Image": "images/key",
          "Title": "Toggle",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "UUID": "com.theoverloadstudio.iseeyou-finder.peek",
      "Name": "Hold to Show",
      "Tooltip": "Show ISeeYou while this key is held, with an optional minimum display time.",
      "PropertyInspectorPath": "hold-settings.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "Icon": "images/action",
      "States": [
        {
          "Image": "images/key",
          "Title": "Hold",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
